# TikTok username đang live (không cần @). Nếu có, env được ưu tiên hơn config.json
TIKTOK_USERNAME=your_tiktok_username

# Port WebSocket + API + trang quản trị
PORT=3000

# Mật khẩu trang quản trị (/admin). Để trống = tự sinh ngẫu nhiên (xem log lúc khởi động)
ADMIN_TOKEN=

# Token bảo vệ WebSocket (tùy chọn). Nếu đặt, client phải kết nối kèm ?token=WS_TOKEN
# (vd: ws://host:3000?token=abc). Để trống = không cần token.
WS_TOKEN=

# Bật chế độ demo (phát dữ liệu giả để test game, không cần TikTok)
DEMO_MODE=false

# Bật nếu muốn lấy thêm thông tin chi tiết về quà tặng (tên, giá, hình ảnh).
# LƯU Ý: bật=true sẽ cần Euler Stream Business plan (trả phí). Nếu không có, để false.
ENABLE_EXTENDED_GIFT_INFO=false

# API key Euler Stream (tùy chọn) - https://www.eulerstream.com
SIGN_API_KEY=

# Đường dẫn file config.json (tùy chọn). Mặc định: ./config.json
CONFIG_PATH=
